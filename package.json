{
  "name": "unred-it",
  "description": "A clean, single-column reader for old.reddit.com, in your own logged-in Firefox.",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Dallas Tidwell",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "wxt -b firefox",
    "build": "wxt build -b firefox",
    "zip": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "lint:amo": "web-ext lint --source-dir .output/firefox-mv3",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run compile && npm run test && npm run build && npm run lint:amo",
    "postinstall": "wxt prepare",
    "sign:unlisted": "node scripts/sign.mjs unlisted",
    "sign:listed": "node scripts/sign.mjs listed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "hls.js": "^1.7.4",
    "preact": "^11.2.0"
  }
}
